<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or device-transferred: synced audio can be re-fetched
     from the Mac, and the Room DB holds the pairing token + TLS pin, which must
     not follow the data to another device (re-pair instead). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
