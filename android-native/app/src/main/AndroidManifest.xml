<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Wi-Fi sync: talking to the Mac's LAN sync server and
         browsing for it over mDNS (_voynix._tcp.). CHANGE_WIFI_MULTICAST_STATE
         is for NsdDiscovery's mDNS browse (auto-sync via WorkManager). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Background Bluetooth/Auto playback: a mediaPlayback foreground service
         keeps the process alive with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- AutoSyncWorker's setForeground while a background sync is running. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Voynix"
        android:supportsRtl="true"
        android:appCategory="audio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Voynix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Routes hardware / Bluetooth AVRCP media buttons to the MediaSession. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Declares this app as a media app so Android Auto binds the browser
             service below without ever starting MainActivity. Proven
             discoverable this way in the android-auto-poc branch spike. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Home-screen "now playing" widget (Glance). Its buttons broadcast
             MEDIA_BUTTON intents at MediaButtonReceiver above, so it needs no
             control path of its own into PlaybackService. -->
        <receiver
            android:name=".widget.NowPlayingWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>

        <!-- WorkManager's own SystemForegroundService declares no
             foregroundServiceType by default, which Android 14+ requires to
             match whatever type AutoSyncWorker.getForegroundInfo() passes to
             setForeground() (dataSync) — override it here rather than in code. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

    </application>

</manifest>
