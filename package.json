{
  "name": "voynix",
  "private": true,
  "version": "0.22.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tekapo/voynix.git"
  },
  "homepage": "https://github.com/tekapo/voynix",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "install:android-native": "cd android-native && ./gradlew installDebug",
    "build:android-native": "cd android-native && ./gradlew assembleRelease",
    "install:android-native:release": "cd android-native && ./gradlew installRelease",
    "install:android-native:release:clean": "cd android-native && ./gradlew uninstallAll installRelease",
    "adb:pair": "bash scripts/adb-wifi.sh pair",
    "install:android-native:wifi": "bash scripts/adb-wifi.sh install",
    "auto:dhu": "node scripts/dhu.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "release": "node scripts/release.mjs",
    "release:android": "node scripts/release-android.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.3.2",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^25.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "ws": "^8.21.3"
  }
}
