{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voynix",
  "version": "0.28.0",
  "identifier": "com.tekapo.voynix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voynix",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://*.dzcdn.net https://*.mzstatic.com; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEN0I1MDkwNkY4REVFOTIKUldTUzdvMXZrRkI3cllVVDJNSTYwSWVGdFNIeUloNUNtZkdLenIxV1BYZDBFWnEyQU1WZXdMbjkK",
      "endpoints": [
        "https://github.com/tekapo/voynix/releases/latest/download/latest.json"
      ]
    }
  }
}
